<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateModIdentity>true</GenerateModIdentity>
    <DefineConstants>$(DefineConstants);ICEBREAKER_SERVER</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Manimal.Icebreaker.Server</RootNamespace>
    <AssemblyName>icebreaker-server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Authors>$(ModUsername)</Authors>
    <Version>$(ModVersion)</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SPTServerPath)\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTServerPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" />
  </ItemGroup>

  <!--
    deploy dll + db + bundles.json into the dev SPT mod folder. the two BUNDLE files
    (615MB scenes + preset) are NOT copied per-build — stage those once by hand or
    with the deploy script; a rebuild only refreshes dll/json.
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <DevModDir>$(SPTServerPath)\user\mods\ManimalIcebreaker</DevModDir>
    </PropertyGroup>
    <ItemGroup>
      <DbFiles Include="$(ProjectDir)db\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(DevModDir)" />
    <Copy SourceFiles="@(DbFiles)" DestinationFiles="@(DbFiles->'$(DevModDir)\db\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(ProjectDir)bundles.json" DestinationFolder="$(DevModDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevModDir)" />
  </Target>

  <!-- the FULL release (single zip, BepInEx + SPT + EscapeFromTarkov_Data trees) is
       built by package-release.ps1 at the repo root -->

  <ItemGroup>
    <Compile Include="..\shared\IcebreakerLocation.cs" Link="IcebreakerLocation.cs" />
    <Compile Include="..\shared\IcebreakerBoreas.cs" Link="IcebreakerBoreas.cs" />
  </ItemGroup>

  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
